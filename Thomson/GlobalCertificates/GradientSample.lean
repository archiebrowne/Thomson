module

public import Thomson.GlobalCertificates.GradientTemplate

open Thomson.Five.FixedIntervalChecker
open Thomson.Five.GlobalCertificates.GradientTemplate
namespace Thomson.Five.GlobalCertificates.GradientSample

noncomputable def block0 : StaticRangeBlock :=
  PackedRanges.decodeBlock 64 

noncomputable def block1 : StaticRangeBlock :=
  PackedRanges.decodeBlock 64 

noncomputable def block2 : StaticRangeBlock :=
  PackedRanges.decodeBlock 64 

noncomputable def data : RangeData :=
  ⟨block0, block1, block2⟩

theorem chunk_0 : checkChunk_0 data = true := by decide +kernel

theorem chunk_1 : checkChunk_1 data = true := by decide +kernel

theorem chunk_2 : checkChunk_2 data = true := by decide +kernel

theorem chunk_3 : checkChunk_3 data = true := by decide +kernel

theorem chunk_4 : checkChunk_4 data = true := by decide +kernel

theorem chunk_5 : checkChunk_5 data = true := by decide +kernel

theorem checked : Certificate data :=
  ⟨chunk_0, chunk_1, chunk_2, chunk_3, chunk_4, chunk_5⟩

@[expose] public def box : VertexFinal.BoxData :=
  ⟨1099559141376, 1099563663360, -549919719424, -549724684288, 952277860352, 952364695552, -549529714688, -549334679552, -952430886912, -952344248320, -195035136, -97517568, 0, 82182144⟩

theorem final_checked : FinalConditions box data 0 := by
  constructor <;> decide +kernel

public theorem exists_checked : ∃ data : RangeData, Certificate data ∧ FinalConditions box data 0 :=
  ⟨data, checked, final_checked⟩

end Thomson.Five.GlobalCertificates.GradientSample
