namespace Leaf586

@[expose] public def box : BoxData :=
  ⟨1597497212928, 1887734267904, 0, 170183557120, 1236867219456, 1549796769792, 0, 170183557120, 0, 170183557120, 170183491584, 340367048704, (-680734031872), (-510550474752)⟩

private noncomputable def dataBlock0 : StaticRangeBlock :=
  decodeBlock 45 

private noncomputable def dataBlock1 : StaticRangeBlock :=
  decodeBlock 44 

private noncomputable def dataBlock2 : StaticRangeBlock :=
  decodeBlock 44 

private noncomputable def data : RangeData :=
  ⟨dataBlock0, dataBlock1, dataBlock2⟩

private def choice : Fin 7 := 3

private theorem chunk0 : checkChunk_0 data = true := by
  decide +kernel

private theorem chunk1 : checkChunk_1 data = true := by
  decide +kernel

private theorem chunk2 : checkChunk_2 data = true := by
  decide +kernel

private theorem chunk3 : checkChunk_3 data = true := by
  decide +kernel

private theorem chunk4 : checkChunk_4 data = true := by
  decide +kernel

private theorem chunk5 : checkChunk_5 data = true := by
  decide +kernel

private theorem checked : Certificate data :=
  ⟨chunk0, chunk1, chunk2, chunk3, chunk4, chunk5⟩

private theorem inputsChecked : inputChecks box data = true := by
  decide +kernel

private theorem separationChecked : separationChecks data = true := by
  decide +kernel

private theorem signChecked : signCheck data choice = true := by
  decide +kernel

private theorem finalChecked : FinalConditions box data choice :=
  ⟨inputsChecked, separationChecked, signChecked⟩

public theorem exists_checked : ∃ (data : RangeData) (choice : Fin 7),
    Certificate data ∧ FinalConditions box data choice :=
  ⟨data, choice, checked, finalChecked⟩

#print axioms exists_checked

end Leaf586

