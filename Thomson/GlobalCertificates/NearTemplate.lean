def boxLower (B : BoxData) (i : Fin 7) : Int :=
  match i.val with
  | 0 => B.lo0 | 1 => B.lo1 | 2 => B.lo2 | 3 => B.lo3
  | 4 => B.lo4 | 5 => B.lo5 | _ => B.lo6

def boxUpper (B : BoxData) (i : Fin 7) : Int :=
  match i.val with
  | 0 => B.hi0 | 1 => B.hi1 | 2 => B.hi2 | 3 => B.hi3
  | 4 => B.hi4 | 5 => B.hi5 | _ => B.hi6

noncomputable def checkCoordinate (B : BoxData) (c : Fin 12) (i : Fin 7) : Bool :=
  Int.ble' (upper c i - 268435456) (boxLower B i) &&
    Int.ble' (boxUpper B i) (lower c i + 268435456)

structure Certificate (B : BoxData) (c : Fin 12) : Prop where
  coordinate0 : checkCoordinate B c 0 = true
  coordinate1 : checkCoordinate B c 1 = true
  coordinate2 : checkCoordinate B c 2 = true
  coordinate3 : checkCoordinate B c 3 = true
  coordinate4 : checkCoordinate B c 4 = true
  coordinate5 : checkCoordinate B c 5 = true
  coordinate6 : checkCoordinate B c 6 = true

end Thomson.Five.GlobalCertificates.NearTemplate
