  ⟨860568485888, 1198122991616, (-998435848192), (-798748639232), 320279216128, 640558497792, (-186337787904), 0, (-745351151616), (-372675575808), (-186337787904), 0, (-971737071616), (-745351086080)⟩

private noncomputable def dataBlock0 : StaticRangeBlock :=
  decodeBlock 44 

