  ⟨inputsChecked, normsChecked, gapChecked⟩

public theorem exists_checked : ∃ (data : RangeData) (choice : Fin 6),
    Certificate data ∧ FinalConditions box data choice :=
  ⟨data, choice, checked, finalChecked⟩

#print axioms exists_checked

